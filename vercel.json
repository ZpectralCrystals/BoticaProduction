{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix frontend && npm ci --prefix backend-fastify",
  "buildCommand": "npm run build --prefix frontend && npm run build --prefix backend-fastify",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/clerk-proxy.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/[...path].ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/__clerk/:path*",
      "destination": "/api/clerk-proxy?clerk_path=:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
