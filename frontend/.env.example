# ══════════════════════════════════════════════════════════════════════════════
# FRONTEND — Variables de entorno
# Copiar como .env para desarrollo local
# ══════════════════════════════════════════════════════════════════════════════

# URL del backend Fastify (sin trailing slash)
VITE_API_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Clerk (autenticación — Fase 2)
# Obtener en: https://dashboard.clerk.com → tu app → API Keys
# Si no se define, Clerk queda deshabilitado y el sistema usa auth local JWT.
# ──────────────────────────────────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_reemplaza_esta_llave

# Verificar integración Clerk en: http://localhost:5173/auth/clerk

# ──────────────────────────────────────────────────────────────────────────────
# Observabilidad (opcional)
# ──────────────────────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=
