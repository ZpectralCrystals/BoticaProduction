# Botica backend -> Supabase pooler
# Copiar fuera del repo o como backend-fastify/.env local no versionado.
# No guardar password real en git.

NODE_ENV=production
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
TRUST_PROXY=true

BOTICA_DB_HOST=aws-0-ca-central-1.pooler.supabase.com
BOTICA_DB_PORT=6543
BOTICA_DB_NAME=postgres
BOTICA_DB_USER=postgres.hzekajqbtzzigvlmrdaa
BOTICA_DB_PASS=<ROTATED_SUPABASE_DB_PASSWORD>
BOTICA_DB_SSL=require
BOTICA_DB_SSL_REJECT_UNAUTHORIZED=false
PGOPTIONS=--search_path=public,extensions

JWT_SECRET=<GENERAR_CON_node_-e_crypto_randomBytes_48_hex>
CORS_ORIGIN=http://localhost:5174

# start.sh remoto
BOTICA_SKIP_DB_BOOTSTRAP=1
BOTICA_APPLY_MIGRATIONS=0

