# ==========================================
# Botica El Pueblo — Backend (Fastify + PostgreSQL)
# Copiar este archivo a .env y completar los valores reales.
# NUNCA commitear el archivo .env al repositorio.
# ==========================================

# ── Servidor ─────────────────────────────
NODE_ENV=development          # development | production
PORT=3000
HOST=127.0.0.1                # En producción usar 0.0.0.0 detrás de Nginx
LOG_LEVEL=info                # trace | debug | info | warn | error
TRUST_PROXY=false             # true detrás de Nginx/Traefik/Cloudflare

# ── Base de datos (PostgreSQL) ────────────
# Estas variables son leídas por src/plugins/db.ts
BOTICA_DB_HOST=localhost
BOTICA_DB_PORT=5432
BOTICA_DB_NAME=botica_db
BOTICA_DB_USER=postgres
BOTICA_DB_PASS=your-secure-db-password
# Supabase/pooler remoto:
# BOTICA_DB_SSL=require
# BOTICA_DB_SSL_REJECT_UNAUTHORIZED=false
# PGOPTIONS=--search_path=public,extensions

# ── Seguridad JWT ─────────────────────────
# OBLIGATORIO en producción (mínimo 32 caracteres aleatorios).
# El servidor NO arrancará en producción si esta variable no está seteada.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-en-produccion-minimo-32-chars

# ── Clerk (identidad ↔ usuario ERP) ───────
# Secret Key: valida sesiones y permite buscar usuarios desde administración.
CLERK_SECRET_KEY=sk_test_reemplaza_esta_llave
# PEM Public Key opcional: validación JWT sin red. Si existe, tiene prioridad conjunta.
CLERK_JWT_KEY=
# Orígenes autorizados del frontend, separados por coma.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:5174
# Issuer esperado adicional (opcional).
# Ejemplo: https://<tu-tenant>.clerk.accounts.dev
CLERK_JWT_ISSUER=

# ── CORS ──────────────────────────────────
# Orígenes permitidos (separados por coma).
# En desarrollo: http://localhost:5173
# En producción: la URL pública del frontend.
CORS_ORIGIN=http://localhost:5173

# ── Observabilidad ────────────────────────
# Integración opcional con Sentry u otro APM.
# No obligatoria para arrancar, pero recomendada en producción.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Vite dev server (solo desarrollo) ────
# Hosts adicionales permitidos por el proxy de Vite.
# Solo necesario si usas Cloudflare Tunnel u otros proxies externos.
# __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=mi-tunel.trycloudflare.com
